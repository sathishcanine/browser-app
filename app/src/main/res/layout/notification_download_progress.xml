<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/notification_download_card_bg"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="14dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/download_notification_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="middle"
                android:maxLines="1"
                android:textColor="@color/download_notification_title"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="Mission Impossible - The Final Reckoning.mp4" />

            <LinearLayout
                android:id="@+id/download_notification_segments"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/download_notification_segment_0"
                    android:layout_width="0dp"
                    android:layout_height="6dp"
                    android:layout_marginEnd="3dp"
                    android:layout_weight="1"
                    android:contentDescription="@null"
                    android:src="@drawable/notification_download_segment_inactive" />

                <ImageView
                    android:id="@+id/download_notification_segment_1"
                    android:layout_width="0dp"
                    android:layout_height="6dp"
                    android:layout_marginEnd="3dp"
                    android:layout_weight="1"
                    android:contentDescription="@null"
                    android:src="@drawable/notification_download_segment_inactive" />

                <ImageView
                    android:id="@+id/download_notification_segment_2"
                    android:layout_width="0dp"
                    android:layout_height="6dp"
                    android:layout_marginEnd="3dp"
                    android:layout_weight="1"
                    android:contentDescription="@null"
                    android:src="@drawable/notification_download_segment_inactive" />

                <ImageView
                    android:id="@+id/download_notification_segment_3"
                    android:layout_width="0dp"
                    android:layout_height="6dp"
                    android:layout_marginEnd="3dp"
                    android:layout_weight="1"
                    android:contentDescription="@null"
                    android:src="@drawable/notification_download_segment_inactive" />

                <ImageView
                    android:id="@+id/download_notification_segment_4"
                    android:layout_width="0dp"
                    android:layout_height="6dp"
                    android:layout_marginEnd="3dp"
                    android:layout_weight="1"
                    android:contentDescription="@null"
                    android:src="@drawable/notification_download_segment_inactive" />

                <ImageView
                    android:id="@+id/download_notification_segment_5"
                    android:layout_width="0dp"
                    android:layout_height="6dp"
                    android:layout_marginEnd="3dp"
                    android:layout_weight="1"
                    android:contentDescription="@null"
                    android:src="@drawable/notification_download_segment_inactive" />

                <ImageView
                    android:id="@+id/download_notification_segment_6"
                    android:layout_width="0dp"
                    android:layout_height="6dp"
                    android:layout_marginEnd="3dp"
                    android:layout_weight="1"
                    android:contentDescription="@null"
                    android:src="@drawable/notification_download_segment_inactive" />

                <ImageView
                    android:id="@+id/download_notification_segment_7"
                    android:layout_width="0dp"
                    android:layout_height="6dp"
                    android:layout_weight="1"
                    android:contentDescription="@null"
                    android:src="@drawable/notification_download_segment_inactive" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/download_notification_speed"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/download_notification_speed"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:text="5.98 MB/s" />

                <TextView
                    android:id="@+id/download_notification_size"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/download_notification_size"
                    android:textSize="12sp"
                    tools:text="85.03 MB / 93.07 MB" />
            </LinearLayout>

            <TextView
                android:id="@+id/download_notification_eta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/download_notification_eta"
                android:textSize="11sp"
                android:visibility="gone"
                tools:text="About 12 seconds left"
                tools:visibility="visible" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/notification_download_icon_bg">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_stat_download" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
