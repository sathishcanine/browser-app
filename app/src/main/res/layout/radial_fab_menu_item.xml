<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center_vertical|end"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingTop="4dp"
    android:paddingEnd="0dp"
    android:paddingBottom="4dp">

    <TextView
        android:id="@+id/radial_fab_item_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:gravity="end"
        android:maxWidth="140dp"
        android:maxLines="2"
        android:rotation="-8"
        android:shadowColor="#80000000"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="3"
        android:textColor="@color/white"
        android:textSize="14sp"
        tools:text="Home" />

    <FrameLayout
        android:id="@+id/radial_fab_item_icon_container"
        android:layout_width="@dimen/radial_fab_item_size"
        android:layout_height="@dimen/radial_fab_item_size"
        android:background="@drawable/radial_fab_item_background"
        android:elevation="6dp">

        <ImageView
            android:id="@+id/radial_fab_item_icon"
            android:layout_width="@dimen/radial_fab_item_icon"
            android:layout_height="@dimen/radial_fab_item_icon"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            tools:src="@drawable/ic_action_plus" />
    </FrameLayout>

</LinearLayout>
