<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/drawerBackground"
    android:orientation="vertical">

    <!-- Top bar: [+New Tab]  [34 ⊞]  [⋮] -->
    <LinearLayout
        android:id="@+id/tab_grid_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/material_grid_margin"
        android:paddingEnd="@dimen/material_grid_margin">

        <ImageView
            android:id="@+id/tab_grid_new_tab"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/tab_grid_new_tab_bg"
            android:contentDescription="@string/action_new_tab"
            android:padding="8dp"
            android:scaleType="center"
            app:srcCompat="@drawable/ic_action_plus"
            app:tint="@color/white" />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Tab count chip (center) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/tab_grid_chip_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <com.browser.minnal.icon.TabCountView
                android:id="@+id/tab_grid_tab_count"
                android:layout_width="28dp"
                android:layout_height="28dp"
                app:tabIconBorderRadius="6dp"
                app:tabIconBorderWidth="1.5dp"
                app:tabIconColor="?attr/iconColor"
                app:tabIconTextSize="13sp" />

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="8dp"
                android:contentDescription="@null"
                app:srcCompat="@drawable/ic_action_grid_view"
                app:tint="?attr/iconColor" />
        </LinearLayout>

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/tab_grid_menu"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/dialog_tools_title"
            android:padding="8dp"
            android:scaleType="center"
            app:srcCompat="@drawable/ic_action_more_vert"
            app:tint="?attr/iconColor" />
    </LinearLayout>

    <!-- Search bar -->
    <EditText
        android:id="@+id/tab_grid_search"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginStart="@dimen/material_grid_margin"
        android:layout_marginEnd="@dimen/material_grid_margin"
        android:layout_marginBottom="4dp"
        android:background="@drawable/tab_grid_search_bg"
        android:hint="@string/search_tabs_hint"
        android:imeOptions="actionSearch"
        android:importantForAutofill="no"
        android:inputType="text"
        android:maxLines="1"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textColor="?attr/autoCompleteTitleColor"
        android:textColorHint="?attr/autoCompleteUrlColor"
        android:textSize="15sp" />

    <!-- Tab grid -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/drawer_tabs_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="ifContentScrolls"
            android:paddingStart="@dimen/material_grid_unit"
            android:paddingEnd="@dimen/material_grid_unit"
            android:paddingBottom="@dimen/material_grid_margin"
            tools:listitem="@layout/tab_grid_card" />

        <TextView
            android:id="@+id/tab_grid_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="@string/tab_search_no_results"
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:textColor="?attr/autoCompleteUrlColor"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Bottom bar: Done button (Chrome-style) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="?attr/drawerBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/material_grid_margin"
        android:paddingEnd="@dimen/material_grid_margin">

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tab_grid_done"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/tab_grid_done_bg"
            android:gravity="center"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:text="@string/tab_grid_done"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>

    <!-- Stub views kept for ViewDelegate compatibility -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/tab_header_button"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:contentDescription="@null" />

        <ImageView
            android:id="@+id/action_back"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:contentDescription="@null" />

        <ImageView
            android:id="@+id/action_forward"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:contentDescription="@null" />

        <ImageView
            android:id="@+id/action_home"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:contentDescription="@null" />

        <ImageView
            android:id="@+id/new_tab_button"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:contentDescription="@null" />
    </LinearLayout>

</LinearLayout>
